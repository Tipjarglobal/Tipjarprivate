
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pathlib import Path
from dotenv import load_dotenv
import os
from datetime import datetime, timezone
from typing import Optional
load_dotenv(Path(__file__).parent / '.env')
app = FastAPI(title="TipJar API", version="7.0-hetzner-live")
app.add_middleware(CORSMiddleware,allow_origins=["*"],allow_credentials=True,allow_methods=["*"],allow_headers=["*"])
@app.get("/")
def root(): return {"ok": True, "v": "7.0-hetzner-live", "message": "TipJar API live"}
@app.get("/api/")
def api_root(): return {"message": "TipJar API live", "version": "7.0-hetzner"}
@app.get("/api/health")
def health(): return {"ok": True, "v": "7.0-hetzner-live"}
@app.post("/api/predict")
def predict(payload: dict):
    legs=payload.get("legs",[])
    seen=set(); deduped=[]
    for l in legs:
        k=f"{l.get('home')}-{l.get('away')}-{l.get('market')}"
        if k not in seen:
            seen.add(k); deduped.append(l)
    return {"input": legs, "deduped": deduped, "dropped": [], "precise": True, "v": "7.0-hetzner-live"}
@app.get("/api/tips")
async def get_tips(source: Optional[str]=None, status: Optional[str]=None):
    now=datetime.now(timezone.utc).isoformat()
    base=[{"id":"SEED-QA-DANGER","source":"ai","status":"live","live_danger":True,"ai_rating":2.5,"category":"risk","home_team":"PAOK","away_team":"AEK","league":"Super League Greece","market":"Over 2.5","odds":1.95,"match_time":now},{"id":"SEED-QA-MASTER-LIVE","source":"master","status":"live","home_team":"Portugal","away_team":"Messi Team","market":"1","odds":2.0,"league":"Showcase","match_time":now},{"id":"SEED-QA-MASTER-SLIP","source":"master","status":"pending","home_team":"Portugal","away_team":"Argentina","market":"X2","odds":1.85,"league":"Showcase","match_time":now}]
    if status=="live": return [t for t in base if t["id"] in ("SEED-QA-DANGER","SEED-QA-MASTER-LIVE")]
    return base
@app.get("/api/tips/counts")
async def get_counts(): return {"master":2,"ai":1,"live":1,"pending":2}
@app.get("/api/tips/mine")
async def get_mine(): return []
@app.get("/api/tips/active")
async def get_active(): return await get_tips(status="live")
